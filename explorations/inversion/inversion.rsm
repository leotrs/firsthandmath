  publisher={Wiley},
  edition={2nd},
}

@book{coxetergreitzer,
  title={Geometry Revisited},
  author={Coxeter, H. S. M. and Greitzer, S. L.},
  year={1967},
  publisher={Mathematical Association of America},
}

::
