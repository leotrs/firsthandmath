; Two circles tangent at T, and inversion in a circle centered at T. Both circles pass through T,
; so their images are lines, and since the circles are tangent there the lines are parallel. A third
; circle, packed between the two, is mapped to a circle packed between the two lines. Dragging the
; third circle slides its image along the gap between the lines.
;
; Inversion here is in the circle of radius 1 around T, drawn faint. The large circle has center
; [1 0] and radius 1, so its image is the line x = 1/2; the small one has center [0.5 0] and
; radius 0.5, so its image is the line x = 1. The image of the third circle has center [0.75 h]
; and radius 0.25, tangent to both lines; the third circle is computed back from it, since
; inversion is its own inverse.

(import house paper ink soft terracotta teal indigo variable)
(import math norm)
(import ease cubic-in-out)

(func[point] inverse ((point x)) (or? (* x (/ 1 (* (norm x) (norm x)))) [0 0]))

; The height of the image circle's center, which the drag sets.
; Far beyond the frame, so the packed circle can be dragged right up to T; its image then leaves
; the frame along the gap.
(real h 0.45 (>= -60) (<= 60))
(point image-c [0.75 h])
(real image-r 0.25 (const))
; The circle whose image that is: its center c / (|c|^2 - r^2) and radius r / | |c|^2 - r^2 |.
; (or? …) only because of mtp-ob7p: a product of norms is inferred maybe-none.
(real power (or? (- (* (norm image-c) (norm image-c)) 0.0625) 0.5))
(point chain-c (or? (* image-c (/ 1 power)) [1.5 0]))
(real chain-r (abs (or? (/ image-r power) 0.5)))


; How strongly each shape named in the caption is highlighted, from 0 to 1, while its name is
; hovered or after it is tapped.
(real glow-t 0 (>= 0) (<= 1))
(real glow-d1 0 (>= 0) (<= 1))
(real glow-d2 0 (>= 0) (<= 1))
(real glow-d1img 0 (>= 0) (<= 1))
(real glow-d2img 0 (>= 0) (<= 1))
(real glow-c 0 (>= 0) (<= 1))
(real glow-cimg 0 (>= 0) (<= 1))

(scene plane
  (circle_ (r 1) (fill none) (stroke soft) (stroke-width 1) (dash [2 4]) (pointer-events false))
  (group drawing (clip (rect_ (pos [0.9 0]) (width 2.6) (height 2.8))) (pointer-events false)
    (defaults (stroke-width 1.75) (fill none))
    ; The bands, under what they highlight.
    (circle_ (pos [1 0]) (r 1) (stroke teal) (stroke-width 12) (stroke-opacity (* 0.22 glow-d1)))
    (circle_ (pos [0.5 0]) (r 0.5) (stroke indigo) (stroke-width 12) (stroke-opacity (* 0.22 glow-d2)))
    (line_ (from [0.5 -5]) (to [0.5 5]) (stroke teal) (stroke-width 12) (stroke-opacity (* 0.22 glow-d1img)))
    (line_ (from [1 -5]) (to [1 5]) (stroke indigo) (stroke-width 12) (stroke-opacity (* 0.22 glow-d2img)))
    (circle_ (pos chain-c) (r chain-r) (stroke terracotta) (stroke-width 12) (stroke-opacity (* 0.22 glow-c)))
    (circle_ (pos image-c) (r image-r) (stroke terracotta) (stroke-width 12) (stroke-opacity (* 0.22 glow-cimg)))
    (circle_ (pos [1 0]) (r 1) (stroke teal))
    (line_ (from [0.5 -5]) (to [0.5 5]) (stroke teal) (dash [6 4]))
    (circle_ (pos [0.5 0]) (r 0.5) (stroke indigo))
    (line_ (from [1 -5]) (to [1 5]) (stroke indigo) (dash [6 4]))
    (circle_ (pos image-c) (r image-r) (stroke terracotta) (dash [6 4]))
    ; When the image circle is out of the frame, above or below, an arrow at that edge of the gap
    ; points to it, as in the first figure.
    (line_ (from [0.75 1.08]) (to [0.75 1.34]) (stroke terracotta) (stroke-width 2) (head-end 'dart')
      (opacity (if (> h 1.65) 1 0)))
    (line_ (from [0.75 -1.08]) (to [0.75 -1.34]) (stroke terracotta) (stroke-width 2) (head-end 'dart')
      (opacity (if (< h -1.65) 1 0))))
  (circle chain (pos chain-c) (r chain-r) (stroke terracotta) (stroke-width 1.75)
    (fill none) (pointer-events false))
  ; The disk at the packed circle's center, by which it is dragged; the page draws a hand in the empty
  ; circle of radius 10.5.
  (group grip (translate chain-c) (fixed-size true)
    (circle_ (r 11) (fill terracotta) (stroke paper) (stroke-width 2))
    (circle_ (r 10.5) (fill none) (stroke none) (pointer-events false)))
  ; Names, as in the Pappus figure: D_1 the large circle, D_2 the small one, C the packed circle,
  ; and their images primed.
  (group names (pointer-events false) (defaults (font variable) (halign 'middle') (valign 'middle'))
    (group d1-name (translate [1.707 -0.707]) (fixed-size true) (text_ 'D₁' (pos [14 -14]) (fill teal)))
    (group d2-name (translate [0.146 -0.354]) (fixed-size true) (text_ 'D₂' (pos [-12 -12]) (fill indigo)))
    (group d1-image-name (translate [0.5 1.25]) (fixed-size true) (text_ 'D₁′' (pos [-18 0]) (fill teal)))
    (group d2-image-name (translate [1 1.25]) (fixed-size true) (text_ 'D₂′' (pos [18 0]) (fill indigo)))
    (group c-name (translate (+ chain-c (* [0.707 0.707] chain-r))) (fixed-size true) (text_ 'C' (pos [10 10]) (fill terracotta)))
    (group c-image-name (translate (+ image-c [0 -0.25])) (fixed-size true) (text_ 'C′' (pos [0 -14]) (fill terracotta))))
  (group t-dot (fixed-size true) (pointer-events false)
    (circle_ (r 11) (fill ink) (stroke none) (opacity (* 0.18 glow-t)))
    (circle_ (r 4) (fill ink) (stroke none))
    (text_ 'T' (pos [-14 0]) (font variable) (fill ink) (halign 'middle') (valign 'middle'))))

(canvas view (x -0.4) (y -1.4) (width 2.6) (height 2.8) (pan false) (zoom false)
  doc@'Two circles tangent at T, a circle packed between them, and their images under inversion at T.'
  plane
  ; The pointer is inverted, and its height sets where the image circle sits along the gap.
  (on-drag grip (move h (to (. (inverse pointer) y)))
    doc@'Slides the packed circle between the two circles; its image slides between the lines.')
  ; Once, when the figure first comes into view, the packed circle nudges along its path and back.
  (on-view (animation (wait 0.6)
    (move h (to 0.8) (duration 0.6) (ease cubic-in-out))
    (move h (to 0.1) (duration 0.9) (ease cubic-in-out))
    (move h (to 0.45) (duration 0.6) (ease cubic-in-out)))
    doc@'Nudges the packed circle once, to show that it moves.'))



; The symbols of the caption, each set inline in its sentence in its shape's color. Hovering one
; highlights what it names in the figure; tapping one (on a phone) highlights it for a moment.

(formula sym-t tex'\term{s}{T}'
  (term s (fill ink)))
(display t-inline sym-t (kind 'inline')
  (on-enter sym-t.s (animation (move glow-t (to 1) (duration 0.2)))
    doc@'Highlights the point T in the figure.')
  (on-leave sym-t.s (animation (move glow-t (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-t.s (animation (move glow-t (to 1) (duration 0.25)) (wait 1) (move glow-t (to 0) (duration 0.25)))
    doc@'Highlights the point T for a moment.'))

(formula sym-d1 tex'\term{s}{D_1}'
  (term s (fill teal)))
(display d1-inline sym-d1 (kind 'inline')
  (on-enter sym-d1.s (animation (move glow-d1 (to 1) (duration 0.2)))
    doc@'Highlights the circle D_1 in the figure.')
  (on-leave sym-d1.s (animation (move glow-d1 (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-d1.s (animation (move glow-d1 (to 1) (duration 0.25)) (wait 1) (move glow-d1 (to 0) (duration 0.25)))
    doc@'Highlights the circle D_1 for a moment.'))

(formula sym-d2 tex'\term{s}{D_2}'
  (term s (fill indigo)))
(display d2-inline sym-d2 (kind 'inline')
  (on-enter sym-d2.s (animation (move glow-d2 (to 1) (duration 0.2)))
    doc@'Highlights the circle D_2 in the figure.')
  (on-leave sym-d2.s (animation (move glow-d2 (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-d2.s (animation (move glow-d2 (to 1) (duration 0.25)) (wait 1) (move glow-d2 (to 0) (duration 0.25)))
    doc@'Highlights the circle D_2 for a moment.'))

(formula sym-d1img tex'\term{s}{D_1^{\prime}}'
  (term s (fill teal)))
(display d1img-inline sym-d1img (kind 'inline')
  (on-enter sym-d1img.s (animation (move glow-d1img (to 1) (duration 0.2)))
    doc@'Highlights the line D_1′ in the figure.')
  (on-leave sym-d1img.s (animation (move glow-d1img (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-d1img.s (animation (move glow-d1img (to 1) (duration 0.25)) (wait 1) (move glow-d1img (to 0) (duration 0.25)))
    doc@'Highlights the line D_1′ for a moment.'))

(formula sym-d2img tex'\term{s}{D_2^{\prime}}'
  (term s (fill indigo)))
(display d2img-inline sym-d2img (kind 'inline')
  (on-enter sym-d2img.s (animation (move glow-d2img (to 1) (duration 0.2)))
    doc@'Highlights the line D_2′ in the figure.')
  (on-leave sym-d2img.s (animation (move glow-d2img (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-d2img.s (animation (move glow-d2img (to 1) (duration 0.25)) (wait 1) (move glow-d2img (to 0) (duration 0.25)))
    doc@'Highlights the line D_2′ for a moment.'))

(formula sym-c tex'\term{s}{C}'
  (term s (fill terracotta)))
(display c-inline sym-c (kind 'inline')
  (on-enter sym-c.s (animation (move glow-c (to 1) (duration 0.2)))
    doc@'Highlights the circle C in the figure.')
  (on-leave sym-c.s (animation (move glow-c (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-c.s (animation (move glow-c (to 1) (duration 0.25)) (wait 1) (move glow-c (to 0) (duration 0.25)))
    doc@'Highlights the circle C for a moment.'))

(formula sym-cimg tex'\term{s}{C^{\prime}}'
  (term s (fill terracotta)))
(display cimg-inline sym-cimg (kind 'inline')
  (on-enter sym-cimg.s (animation (move glow-cimg (to 1) (duration 0.2)))
    doc@'Highlights the circle C′ in the figure.')
  (on-leave sym-cimg.s (animation (move glow-cimg (to 0) (duration 0.3)))
    doc@'Takes the highlight away.')
  (on-click sym-cimg.s (animation (move glow-cimg (to 1) (duration 0.25)) (wait 1) (move glow-cimg (to 0) (duration 0.25)))
    doc@'Highlights the circle C′ for a moment.'))
