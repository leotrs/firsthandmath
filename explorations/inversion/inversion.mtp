; Inversion in a circle, in Firsthand Math's colors. p is dragged, and its inverse q sits on the
; same ray from the center, at distance 1 / |p|; only p is dragged. Two toggles
; add a circle through the center, whose image is a line, and a circle that misses it, whose
; image is a circle; each is dragged by its center.
;
; Each pair has one color: p and q terracotta, the circle through the center and its image teal,
; the circle that misses it and its image indigo. An original is drawn solid and its image dashed
; (q, a point, is a ring). While one pair is dragged, the others fade.

(import house paper ink soft terracotta teal indigo variable number)
(import math norm)
(import ease cubic-out cubic-in-out)

; The inverse of a point x other than the center: on the same ray, at distance 1 / |x|.
(func[point] inverse ((point x)) (or? (* x (/ 1 (* (norm x) (norm x)))) [0 0]))
; The unit direction at right angles to c, a quarter turn counterclockwise from it.
(func[point] across ((point c)) (or? (* [(- 0 c.y) c.x] (/ 1 (norm c))) [0 1]))

(point p [0.6 0.35])
; The center has no inverse, so there q is drawn at the center.
(point q (inverse p))
; The ray's direction, for placing the names: p's sits just inside p, and q's just outside q,
; so the two never meet.
(point ray (or? (* p (/ 1 (norm p))) [1 0]))
; At right angles to the ray, for P's name, which so stays clear of the arrows along the ray.
(point ray-side (polar 1 (+ (let ((r (or? (to-polar ray) [1 0]))) r[1]) 90)))
; How close p (and so q) is to the circle: 1 on it, falling to 0 at a distance of 0.12. The rim
; thickens and the disk tints with it, so the circle lights up as p reaches it, by finger too.
; Whether P and Q are shown, by their toggle; on at first.
(bool show-pq true)
(real near-rim (if show-pq (or? (max 0 (- 1 (* (abs (- (norm p) 1)) (/ 1 0.12)))) 0) 0))
; A point dragged within 0.06 of the circle lands on it, since a finger cannot place it exactly.
(func[point] snap ((point x)) (if (< (abs (- (norm x) 1)) 0.06) (or? (* x (/ 1 (norm x))) x) x))

; The view box's half width and half height, for telling when p or q is out of the frame.
(real half-w 2.2 (const))
(real half-h 1.5 (const))
; The frame stops closer below the circle than above it, so the formula under the figure sits close.
(real bottom 1.15 (const))
; The one of p and q further from the center, and whether it is out of the frame.
(point far (if (> (norm q) (norm p)) q p))
(bool far-out (or (> (abs far.x) half-w) (> far.y half-h) (< far.y (- 0 bottom))))
; How far along the ray the frame's edge is.
(real edge (min (or? (/ half-w (abs ray.x)) 100) (or? (/ (if (> ray.y 0) half-h bottom) (abs ray.y)) 100)))

; The centers of the two circles, dragged; the formulas under the figure read them.
(point through-c [0.4 -0.45])
(point misses-c [-1.3 -0.5])
(bool show-through false)
(bool show-misses false)
; How strongly each pair is drawn: all 1, and while one pair is dragged the others fade.
(real fade-pq 1 (>= 0) (<= 1))
(real fade-through 1 (>= 0) (<= 1))
(real fade-misses 1 (>= 0) (<= 1))

; A circle through the center, dragged by its position: its radius is the distance from the
; center to that position, so it always passes through the center.
(motif through-center ()
  (circle_ (r (norm self.pos)) (stroke teal) (fill teal) (fill-opacity 0) (pointer-events false)))

(scene plane
  (circle disk (r 1) (fill ink) (fill-opacity (* 0.06 near-rim)) (pointer-events false))
  (circle unit (r 1) (fill none) (stroke ink) (stroke-width (+ 2 (* 3 near-rim))) (pointer-events false))

  ; Cut to the frame, so that a line or a large image circle does not run off the figure.
  (group pairs (clip (rect_ (pos [0 0.175]) (width 4.4) (height 2.65))) (defaults (stroke-width 1.75))
    ; A circle through the center, centered at c: its radius is |c|, so it stays through the
    ; center, and its image is the line of points t with t · c = 1/2, through c / (2 |c|^2) and
    ; at right angles to c.
    (group through-pair (defaults (opacity (* (if show-through 1 0) fade-through))) (pointer-events show-through)
      (through-center through (pos through-c))
      ; A disk at the circle's center, by which it is dragged; the page draws a hand on it.
      (group through-grip (translate through-c) (fixed-size true)
        (circle_ (r 11) (fill teal) (stroke paper) (stroke-width 2))
        (circle_ (r 10.5) (fill none) (stroke none) (pointer-events false)))
      (line_ (from (- (* (inverse through.pos) 0.5) (* (across through.pos) 6)))
          (to (+ (* (inverse through.pos) 0.5) (* (across through.pos) 6)))
          (stroke teal) (dash [6 4]) (pointer-events false)))
    ; A circle that misses the center, centered at c with radius r: its image is centered at
    ; c / (|c|^2 - r^2), with radius r / | |c|^2 - r^2 |.
    (group misses-pair (defaults (opacity (* (if show-misses 1 0) fade-misses))) (pointer-events show-misses)
      (circle misses (pos misses-c) (r 0.35) (stroke indigo) (fill indigo) (fill-opacity 0) (pointer-events false))
      ; A disk at the circle's center, by which it is dragged; the page draws a hand on it.
      (group misses-grip (translate misses-c) (fixed-size true)
        (circle_ (r 11) (fill indigo) (stroke paper) (stroke-width 2))
        (circle_ (r 10.5) (fill none) (stroke none) (pointer-events false)))
      (circle_ (pos (or? (* misses-c (/ 1 (- (* (norm misses-c) (norm misses-c)) 0.1225))) [0 0]))
          (r (abs (or? (/ 0.35 (- (* (norm misses-c) (norm misses-c)) 0.1225)) 0)))
          (stroke indigo) (dash [6 4]) (fill none) (pointer-events false))))

  (group pq (defaults (opacity (* (if show-pq 1 0) fade-pq))) (pointer-events show-pq)
    (group marks (pointer-events false)
      (line_ (from [0 0]) (to far) (stroke soft) (stroke-width 1) (dash [4 4]))
      ; When p or q is out of the frame, an arrow at the frame's edge points along the dashed
      ; line toward it.
      (line_ (from (* ray (- edge 0.32))) (to (* ray (- edge 0.06)))
          (stroke terracotta) (stroke-width 2) (head-end 'dart') (opacity (if (and far-out show-pq) fade-pq 0)))
      )

    ; The points keep their size on screen, in pixels; each name sits 26 pixels from its point,
    ; along the ray.
    (group names (pointer-events false) (defaults (font variable) (fill ink) (halign 'middle') (valign 'middle'))
      (group p-name (translate p) (fixed-size true) (text_ 'P' (pos (* ray-side 22))))
      (group q-name (translate q) (fixed-size true) (text_ 'Q' (pos (* ray 26)))))
    ; P, a disk with a hand on it, which the page draws in the empty circle of radius 10.5; on the
    ; circle P shrinks into Q's ring, and the hand fades.
    (group p-dot (translate p) (fixed-size true)
      (circle_ (r (- 11 (* 6 near-rim))) (fill terracotta) (stroke paper) (stroke-width 2))
      (circle_ (r 10.5) (fill none) (stroke none) (pointer-events false) (opacity (- 1 near-rim))))
    ; Q is the image, so it is drawn as images are: dashed, with no fill. Only P is dragged.
    (group q-dot (translate q) (fixed-size true) (pointer-events false)
      (circle_ (r 8) (fill none) (stroke terracotta) (stroke-width 2.5) (dash [3 2.5]))))
  (group center-dot (fixed-size true) (pointer-events false) (circle_ (r 4) (fill ink))))

(canvas view (x -2.2) (y -1.15) (width 4.4) (height 2.65) (pan false) (zoom false)
  doc@'The circle, p, and its inverse q.'
  plane)

; While one pair is dragged the others fade, and they come back when it is let go.
(animation focus-pq
  (at-once (defaults (duration 0.2) (ease cubic-out))
    (move fade-through (to 0.15)) (move fade-misses (to 0.15))))
(animation focus-through
  (at-once (defaults (duration 0.2) (ease cubic-out))
    (move fade-pq (to 0.15)) (move fade-misses (to 0.15))))
(animation focus-misses
  (at-once (defaults (duration 0.2) (ease cubic-out))
    (move fade-pq (to 0.15)) (move fade-through (to 0.15))))
(animation unfocus
  (at-once (defaults (duration 0.3) (ease cubic-out))
    (move fade-pq (to 1)) (move fade-through (to 1)) (move fade-misses (to 1))))

(on-drag p-dot (move p (to (snap pointer))) doc@'Moves p; q follows.')
(on-drag through-grip (move through-c (to pointer)) doc@'Moves the circle through the center, by its grip.')
(on-drag misses-grip (move misses-c (to pointer)) doc@'Moves the circle that misses the center, by its grip.')
(on-dragstart through-grip (animation focus-through) doc@'Fades the other pairs.')
(on-dragstart misses-grip (animation focus-misses) doc@'Fades the other pairs.')
(on-dragend through-grip (animation unfocus) doc@'Brings the other pairs back.')
(on-dragend misses-grip (animation unfocus) doc@'Brings the other pairs back.')
(on-dragstart p-dot (animation focus-pq) doc@'Fades the other pairs.')
(on-dragend p-dot (animation unfocus) doc@'Brings the other pairs back.')

(toggle show-pq-toggle show-pq (label 'P and Q')
  doc@'Shows P and its inverse Q.')
(toggle show-through-toggle show-through (label 'a circle through the center')
  doc@'Shows a circle through the center, and its image, a line.')
(toggle show-misses-toggle show-misses (label 'a circle missing the center')
  doc@'Shows a circle that misses the center, and its image, a circle.')

; The product |P| |Q|, typeset under the figure, with the two lengths in P and Q's color.
(formula product
  tex'|P| \cdot |Q| = \term{a}{} \cdot \term{b}{} = 1'
  (term a (tex $'{(norm p):.2f}') (fill terracotta))
  (term b (tex $'{(norm q):.2f}') (fill terracotta)))
(display product-display product)

; Shown while the green circle is: its diameter times the distance from O to its image line is
; always 1, as |P| |Q| is, and the line's equation, t . c = 1/2 for its center c.
(formula through-facts
  tex'\begin{aligned}&\text{diameter} \cdot \text{distance to the line} = \term{d}{} \cdot \term{e}{} = 1 \\ &\text{the line:}\ \term{a}{}\,x \term{b}{}\,y = \tfrac{1}{2}\end{aligned}'
  (term d (tex $'{(or? (* 2 (norm through-c)) 0):.2f}') (fill teal))
  (term e (tex $'{(or? (/ 1 (* 2 (norm through-c))) 0):.2f}') (fill teal))
  (term a (tex $'{through-c.x:.2f}') (fill teal))
  (term b (tex $'{through-c.y:+.2f}') (fill teal)))
(display through-display through-facts)
; Shown while the blue circle is: its radius and its image's, and the distances from O to the
; inverse of its center and to its image's center, which differ.
(formula misses-facts
  tex'\begin{aligned}&\text{radius}\ \term{r}{} \ \to\ \text{image radius}\ \term{s}{} \\ &\text{inverse of the center at}\ \term{i}{} \\ &\text{center of the image at}\ \term{j}{}\end{aligned}'
  (term r (tex '0.35') (fill indigo))
  (term s (tex $'{(abs (or? (/ 0.35 (- (* (norm misses-c) (norm misses-c)) 0.1225)) 0)):.2f}') (fill indigo))
  (term i (tex $'{(or? (/ 1 (norm misses-c)) 0):.2f}') (fill indigo))
  (term j (tex $'{(abs (or? (/ (norm misses-c) (- (* (norm misses-c) (norm misses-c)) 0.1225)) 0)):.2f}') (fill indigo)))
(display misses-display misses-facts)
; Once, when the figure first comes into view, P moves out along its ray, then in, then back.
(on-view view (animation (wait 0.6)
  (move p (to [0.78 0.455]) (duration 0.6) (ease cubic-in-out))
  (move p (to [0.42 0.245]) (duration 0.9) (ease cubic-in-out))
  (move p (to [0.6 0.35]) (duration 0.6) (ease cubic-in-out)))
  doc@'Moves P out and in along its ray once, to show that it moves.')
