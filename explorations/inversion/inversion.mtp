; Inversion in a circle, in Firsthand Math's colors. p follows the pointer, and its inverse q sits
; on the same ray from the center, at distance 1 / |p|. The toggle adds two circles (terracotta,
; like p) and their images (teal, like q): one through the center, whose image is a line, and one
; that misses it, whose image is a circle.

(import house paper ink soft terracotta teal variable number)
(import math norm)
(import ease cubic-out)

(point p [0.6 0.35])
; The center has no inverse, so there q is drawn at the center.
(point q (or? (* p (/ 1 (* (norm p) (norm p)))) [0 0]))
; Along the ray: p's name sits just inside p, and q's just outside q, so the two never meet.
(point along (or? (* p (/ 0.18 (norm p))) [0.18 0]))
(bool circles false)

(scene plane
  (circle disk (r 1) (fill teal) (fill-opacity 0) (pointer-events false))
  (circle unit (r 1) (fill none) (stroke ink) (stroke-width 2))
  (group marks (pointer-events false)
    ; A circle through the center, centered at c = [0.4 0.4]: its image is the line of points t
    ; with t · c = 1/2 (x + y = 1.25), through c / (2 |c|^2) = [0.625 0.625], cut to the canvas,
    ; which does not clip.
    ; A circle that misses the center, centered at c = [-1.3 -0.5] with radius 0.35: its image is
    ; centered at c / (|c|^2 - r^2), with radius r / (|c|^2 - r^2), and |c|^2 - r^2 = 1.8175.
    (group pairs (defaults (fill none) (stroke-width 1.75) (opacity (if circles 1 0)))
      (circle_ (pos [0.4 0.4]) (r 0.5657) (stroke terracotta))
      (line_ (from [-0.25 1.5]) (to [2.2 -0.95]) (stroke teal))
      (circle_ (pos [-1.3 -0.5]) (r 0.35) (stroke terracotta))
      (circle_ (pos [-0.7153 -0.2751]) (r 0.1926) (stroke teal)))
    (line_ (from [0 0]) (to (if (> (norm q) (norm p)) q p)) (stroke soft) (stroke-width 1)
        (dash [4 4]))
    (circle_ (r 0.04) (fill ink))
    (group names (defaults (font variable) (fill ink) (halign 'middle') (valign 'middle'))
      (text_ 'p' (pos (- p along)))
      (text_ 'q' (pos (+ q along))))
    (group points (defaults (stroke paper) (stroke-width 2))
      (circle_ (pos p) (r 0.07) (fill terracotta))
      (circle_ (pos q) (r 0.07) (fill teal)))
    (text_ $'|p| = {(norm p):.2f}    |q| = {(norm q):.2f}    |p| · |q| = 1'
        (pos [0 -1.38]) (font number) (fill soft) (halign 'middle'))))

(canvas view (x -2.2) (y -1.5) (width 4.4) (height 3) (pan false) (zoom false)
  doc@'The circle, p, and its inverse q.'
  plane)

(on-pointermove view p doc@'p follows the pointer.')
(toggle show-circles circles (label 'circles and their images')
  doc@'Shows a circle through the center and one that misses it, with their images.')
(on-enter unit
    (animation
      (at-once (defaults (duration 0.25) (ease cubic-out))
        (move unit.stroke-width (to 5))
        (move disk.fill-opacity (to 0.14))))
  doc@'Thickens the rim and tints the disk while the pointer is on the rim.')
(on-leave unit
    (animation
      (at-once (defaults (duration 0.5) (ease cubic-out))
        (move unit.stroke-width (to 2))
        (move disk.fill-opacity (to 0))))
  doc@'Brings the circle back.')
